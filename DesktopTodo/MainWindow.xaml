<Window x:Class="DesktopTodo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面提醒" Width="410" Height="650" MinWidth="220" MinHeight="150"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" ShowInTaskbar="False" FontFamily="Microsoft YaHei UI"
        Loaded="Window_Loaded" Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized"
        SizeChanged="Window_SizeChanged" PreviewKeyDown="Window_PreviewKeyDown"
        MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave">
    <Window.Resources>
        <SolidColorBrush x:Key="Blue" Color="#1677FF"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#5F5F5F"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Margin="2" CornerRadius="5"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#0F000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#19000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Margin="2" CornerRadius="5"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#A92317"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TodoCheckBox" TargetType="CheckBox">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="20" Height="20">
                            <Ellipse x:Name="CheckCircle" Fill="White"
                                     Stroke="#A8A8AE" StrokeThickness="1.5"/>
                            <Path x:Name="CheckMark" Data="M 5,10 L 8.5,13.5 L 15,6.5"
                                  Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckCircle" Property="Stroke" Value="#1677FF"/>
                                <Setter TargetName="CheckCircle" Property="Fill" Value="#0D1677FF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckCircle" Property="Stroke" Value="#1677FF"/>
                                <Setter TargetName="CheckCircle" Property="Fill" Value="#1677FF"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="CheckCircle" Property="Stroke" Value="#0F67DC"/>
                                <Setter TargetName="CheckCircle" Property="Fill" Value="#0F67DC"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowSurface" Margin="10" CornerRadius="16" Background="#FFF8F8FA"
            BorderBrush="#18000000" BorderThickness="1"
            MouseLeftButtonDown="Surface_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity=".2"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="Auto"/>
                <RowDefinition x:Name="TitleRow" Height="Auto"/>
                <RowDefinition x:Name="ToolsRow" Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="AddRow" Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderPanel" Grid.Row="0" Background="Transparent"
                  Height="52" ClipToBounds="True"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="18,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="18" Height="18" Fill="#1677FF"/>
                    <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontSize="14"
                               FontWeight="SemiBold" Foreground="#444" Text="提醒事项"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0"
                            VerticalAlignment="Center">
                    <Button x:Name="PinButton" Style="{StaticResource ChromeButton}"
                            ToolTip="始终置顶" Click="Pin_Click" Content="&#xE718;"/>
                    <Button Style="{StaticResource ChromeButton}" ToolTip="隐藏到托盘"
                            Click="Hide_Click" Content="&#xE921;"/>
                    <Button Style="{StaticResource CloseButton}" ToolTip="退出"
                            Click="Exit_Click" Content="&#xE8BB;"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="TitlePanel" Grid.Row="1" Margin="18,8,18,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="今天" FontSize="30"
                               FontWeight="Bold" Foreground="#161617"/>
                    <TextBlock x:Name="CountText" Margin="2,3,0,0" Foreground="#777" FontSize="12"/>
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Bottom" Foreground="#1677FF"
                        Click="ClearCompleted_Click" Content="清除已完成"/>
            </Grid>

            <StackPanel x:Name="ToolsPanel" Grid.Row="2" Margin="18,8,18,10">
                <Border Background="#FFE9E9ED" CornerRadius="9" Height="36">
                    <Grid>
                        <TextBlock Margin="12,0" VerticalAlignment="Center" Foreground="#888" Text="搜索"/>
                        <TextBox x:Name="SearchBox" Margin="8,0" TextChanged="Search_TextChanged"/>
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="TodayFilter" Click="Filter_Click" Tag="Today"
                            Content="今天" Foreground="#1677FF"/>
                    <Button Click="Filter_Click" Tag="All" Content="全部"/>
                    <Button Click="Filter_Click" Tag="Completed" Content="已完成"/>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="3">
                <TextBlock x:Name="EmptyText" Text="暂时没有提醒事项" Foreground="#999"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
                <ListBox x:Name="TodoList" Margin="10,0" Padding="0,3"
                         Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding VisibleItems}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PreviewMouseWheel="TodoList_PreviewMouseWheel"
                         MouseLeave="TodoList_MouseLeave"
                         KeyDown="TodoList_KeyDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="3,4"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <EventSetter Event="PreviewMouseMove" Handler="Item_PreviewMouseMove"/>
                            <EventSetter Event="Drop" Handler="Item_Drop"/>
                            <Setter Property="AllowDrop" Value="True"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="TodoCard" MinHeight="54" Padding="3,2" CornerRadius="11"
                                    Background="White" BorderBrush="#10000000" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                                                                          Direction="270" Opacity=".16"
                                                                          Color="#60000000"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource TodoCheckBox}"
                                              IsChecked="{Binding IsCompleted}" Click="Complete_Click"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Width="20" Height="20"/>
                                    <StackPanel Grid.Column="1" Margin="4,6"
                                                VerticalAlignment="Center">
                                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                 Opacity="{Binding TitleOpacity}"
                                                 LostFocus="Title_LostFocus"/>
                                        <TextBlock Text="{Binding DueText}" Foreground="#D44747"
                                                   FontSize="11" Margin="2,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="2" Width="36" Content="⋯" Foreground="#777"
                                            Visibility="{Binding DataContext.ItemActionsVisibility,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                            Click="More_Click" ToolTip="设置时间或删除"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Button x:Name="AddButton" Grid.Row="4" HorizontalAlignment="Left"
                    Height="54" Margin="14,0" Foreground="#1677FF" FontSize="14"
                    FontWeight="SemiBold" Click="Add_Click" Content="＋  新建提醒事项"/>
        </Grid>
    </Border>
</Window>
